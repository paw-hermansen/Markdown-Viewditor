{
  "name": "markdown-viewditor",
  "version": "1.4.5",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "tauri:windows:build": "tauri-windows-bundle build --runner npm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:components": "vitest run --environment jsdom src/lib/components"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.29",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/html2canvas": "^0.5.35",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-anchor": "^4.0.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.0.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.0.0",
    "@codemirror/view": "^6.43.11",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "js-yaml": "^5.4.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-highlightjs": "^4.3.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "skia-canvas@3.0.8": true
  }
}
