{
  "$schema": "./gen/schemas/desktop-schema.json",
  "productName": "Markdown Viewditor",
  "version": "0.1.0",
  "identifier": "com.github.paw-hermansen.markdown-viewditor",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "enableGTKAppId": false,
    "windows": [
      {
        "label": "main",
        "title": "Markdown Viewditor",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' localimg: http://localimg.localhost asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon_32.png",
      "icons/icon_48.png",
      "icons/icon_64.png",
      "icons/icon_128.png",
      "icons/icon_256.png",
      "icons/icon_512.png"
    ],
    "category": "Productivity",
    "shortDescription": "A markdown viewer and editor with live preview",
    "copyright": "Copyright © 2026 Paw Hermansen",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "publisher": "Paw Hermansen",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "section": "editors"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
